@using JobHuntTracker.Data
@using System.Text.RegularExpressions

<BarChart @ref="barChart" />

@code {
    private BarChart barChart = default!;
    private BarChartOptions barChartOptions = default!;

    protected override void OnInitialized()
    {
        barChartOptions = new BarChartOptions();
        barChartOptions.Responsive = true;
        barChartOptions.MaintainAspectRatio = false;
        barChartOptions.Interaction = new Interaction { Mode = InteractionMode.Y };
        barChartOptions.IndexAxis = "y";

        barChartOptions.Scales.X!.Title = new ChartAxesTitle { Text = "Total", Display = true };
        barChartOptions.Scales.Y!.Title = new ChartAxesTitle { Text = "Sites", Display = true };

        barChartOptions.Plugins.Legend.Display = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var chartData = GetChartData();
            await barChart.InitializeAsync(chartData, barChartOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    /// <summary>
    /// Get the chart data based on the applications
    /// </summary>
    /// <returns>chart specific data</returns>
    private ChartData GetChartData()
    {
        var applications = DataSource.Get();

        var datasets = new List<IChartDataset>();
        var colors = BlazorExpress.ChartJS.ColorUtility.CategoricalTwelveColors;
        var yAxisLabels = new List<(string label, int count)> { ("Indeed",0), ("LinkedIn",0), ("Other",0) };

        foreach(var application in applications)
        {
            if (string.Equals(application.SiteApplied, yAxisLabels[0].label, StringComparison.OrdinalIgnoreCase))
            {
                yAxisLabels[0] = (yAxisLabels[0].label, yAxisLabels[0].count + 1);
            }
            else if (string.Equals(application.SiteApplied, yAxisLabels[1].label, StringComparison.OrdinalIgnoreCase))
            {
                yAxisLabels[1] = (yAxisLabels[1].label, yAxisLabels[1].count + 1);
            }
            else
            {
                yAxisLabels[2] = (yAxisLabels[2].label, yAxisLabels[2].count + 1);
            }
        }

        datasets.Add(new BarChartDataset()
        {
            Data = new List<double?> 
            { 
                yAxisLabels[0].count,
                yAxisLabels[1].count,
                yAxisLabels[2].count
            },
            BackgroundColor = new List<string> { colors[0] },
            BorderColor = new List<string> { colors[0] },
            BorderWidth = new List<double> { 0 },
        });


        return new ChartData { Labels = yAxisLabels.Select(s => s.label).ToList(), Datasets = datasets };
    }
}
