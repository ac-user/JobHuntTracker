<div data-bs-toggle="collapse" href="#@Id" role="button" aria-expanded="false" aria-controls="@Id">
    @Header
</div>
<div class="collapse" id="@Id">
    <div class="card card-body">
        @CollapsedContent
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; }
    [Parameter]
    public string Header { get; set; }
    [Parameter]
    public string CollapsedContent { get; set; }
}
