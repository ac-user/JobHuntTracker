@page "/"
@inject NavigationManager Navigation
@using JobHuntTracker.Data
@using JobHuntTracker.Models

<div id="home">
    <section id="header">
       <h3>Welcome</h3>
       <p>Find all your job tracking needs here!</p>
    </section>
    <section id="nav-options">
        <Button Class="tile" @onclick="OnClick_OpenNewApplication" tabindex="2" aria-label="Add job application">
            <i class="bi bi-plus"/>
        </Button>
        <Button Class="tile" @onclick="() => Navigation.NavigateTo(ApplicationSearch.Route)" tabindex="3" aria-label="All applications">
            <span>Applied Post's</span>
        </Button>
        <Button Class="tile" @onclick="() => Navigation.NavigateTo(DefaultQuestions.Route)" tabindex="4" aria-label="Default questions">
            <span>Default Questions</span>
        </Button>
        <Button Class="tile" @onclick="() => Navigation.NavigateTo(Statistics.Route)" tabindex="5" aria-label="Statistics">
            <i class="bi bi-bar-chart" />
        </Button>
    </section>

    <section id="recent-applications">
        <div id="mini-stats">
            <span>@applications.Count() Total</span>
            <span>@applications.Where(w => w.IsActive).Count() Open</span>
            <span>@applications.Where(w => !w.IsActive).Count() Closed</span>
        </div>
        <div id="recent-list" tabindex="7">
            @foreach (var application in applications.Where(w => w.IsActive).OrderByDescending(o => o.LastModified).Take(20))
            {
                <Card @key="application.Id" @onclick="() => Navigation.NavigateTo(Application.Route + application.Id)">
                    <CardBody>
                        <CardTitle>@application.Title</CardTitle>
                        <span class="company">@application.Company</span>
                        <span class="salary">@application.Salary</span>
                        <div class="status">@(GetStatus(application))</div>
                    </CardBody>
                </Card>
            }
        </div>
    </section>

    <section id="application-stats">
        <Carousel Autoplay="CarouselAutoPlay.StartOnPageLoad" tabindex="6">
            <CarouselItem Active="true">
                <JobHuntTracker.Components.Elements.RecruitementSite/>
            </CarouselItem>
            <CarouselItem>
                <JobHuntTracker.Components.Elements.ApplicationsByDate Interactive="false"/>
            </CarouselItem>
        </Carousel>
    </section>
</div>

<JobHuntTracker.Components.Modules.NewApplication 
                IsOpen="@showNewApplication"
                OnSave="OnSave_SaveApplication"
                OnCancel="OnCancel_CloseNewApplication" />

@code {
    /// <summary>
    /// The page route
    /// </summary>
    public const string Route = "/";

    private bool showNewApplication;

    private List<JobApplication> applications = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            applications = DataSource.Get();
            StateHasChanged();
        }
    }

    /// <summary>
    ///  Get the status of the application
    /// </summary>
    /// <param name="jobApplication">application</param>
    /// <returns>current interview process status</returns>
    private string GetStatus(JobApplication jobApplication)
    {
        if (!jobApplication.IsActive) return "Closed";
        if (!String.IsNullOrWhiteSpace(jobApplication.Step)) return "Interviewing";
        return "Submitted";
    }

    /// <summary>
    /// Display the new job application modal
    /// </summary>
    private void OnClick_OpenNewApplication()
    {
        showNewApplication = true;
    }

    /// <summary>
    /// Close the job application modal
    /// </summary>
    private void OnCancel_CloseNewApplication()
    {
        showNewApplication = false;
    }

    /// <summary>
    /// Save a new job application
    /// </summary>
    /// <param name="application">application to save</param>
    private Task OnSave_SaveApplication(JobApplication application)
    {
        applications.Add(application);
        DataSource.Create(application);       

        showNewApplication = false;

        return Task.CompletedTask;
    }
}


