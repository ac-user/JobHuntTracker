@page "/default-questions"
@using JobHuntTracker.Data
@using JobHuntTracker.Models

<JobHuntTracker.Components.Elements.Tabs @bind-ActiveTab="activeSection" />
<section id="default-questions">
    <JobHuntTracker.Components.Elements.NewQuestion OnClickAdd="OnClick_AddNewQuestion"/>
    <hr/>
    <SortableList Id="list"
                  Handle=".bi-grip-vertical"
                  TItem="InterviewQuestion"
                  Data="DeafultInterviewQuestions.Where(w => w.Section == activeSection).OrderBy(o => o.Position).ToList()"
                  Context="item"
                  OnUpdate="OnListUpdate">
                  <ItemTemplate>
                        <div @key="item.Id" id="@item.Id" class="input-group">
                            <div class="bi bi-grip-vertical input-group-text"/>
                            <InputText class="form-control"
                                       @bind-Value="item.Question"
                                       readonly="@(editingQuestionId != item.Id)"
                                       @ondblclick="() => OnDblClick_BeginEdit(item)"
                                       @onblur="() => OnBlur_SaveQuestion(item)" />
                            <i role="button" class="bi bi-x-square input-group-text" @onclick="() => OnClick_DeleteQuestion(item)" />
                        </div>
                  </ItemTemplate>
    </SortableList>    
</section>

@code {
    /// <summary>
    /// The page route
    /// </summary>
    public const string Route = "/default-questions";
    /// <summary>
    /// List of default interview questions all job applications will have
    /// </summary>
    List<InterviewQuestion> DeafultInterviewQuestions = new();

    private string activeSection;
    private int maxPosition;
    private Guid? draggedQuestionId;
    private Guid? editingQuestionId;

    protected override void OnAfterRender(bool firstRender)
    {
        if(firstRender)
        {
            DeafultInterviewQuestions = DataSource.GetDefaultQuestions();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Add new default question to interview questions
    /// </summary>
    /// <param name="newQuestion">new question</param>
    private void OnClick_AddNewQuestion(string newQuestion)
    {
        DeafultInterviewQuestions.Add(new InterviewQuestion()
        {
            Id = Guid.NewGuid(),
            Position = maxPosition++,
            Question = newQuestion,
            Section = activeSection
        });

        DataSource.Upsert(DeafultInterviewQuestions);
        newQuestion = "";
    }

    /// <summary>
    /// Delete a default interview question
    /// </summary>
    /// <param name="question">question to be deleted</param>
    private void OnClick_DeleteQuestion(InterviewQuestion question)
    {
        int position = 0;
        DeafultInterviewQuestions.Remove(question);
        foreach (var sectionItem in DeafultInterviewQuestions.Where(w => w.Section == activeSection)
                                                             .OrderBy(o => o.Position))
        {
            sectionItem.Position = position;
            position++;
        }

        if (editingQuestionId == question.Id)
            editingQuestionId = null;

        if (draggedQuestionId == question.Id)
            draggedQuestionId = null;

        DataSource.Upsert(DeafultInterviewQuestions);
    }

    /// <summary>
    /// Enable editing on interview question
    /// </summary>
    /// <param name="question">question to enable editing on</param>
    private void OnDblClick_BeginEdit(InterviewQuestion question)
    {
        editingQuestionId = question.Id;
    }

    /// <summary>
    /// Update position of questions
    /// </summary>
    /// <param name="args">sortable list elements information</param>
    private void OnListUpdate(SortableListEventArgs args)
    {
        if (args.OldIndex == args.NewIndex)
            return;

        var items = DeafultInterviewQuestions.Where(w => w.Section == activeSection).OrderBy(o => o.Position).ToList();
        var itemToMove = items[args.OldIndex];

        // Move the dragged question to the target position.
        if (args.OldIndex < args.NewIndex)
        {
            // Moving down: shift intervening questions up.
            foreach (var question in items)
            {
                if (question.Id != itemToMove.Id &&
                    question.Position > args.OldIndex &&
                    question.Position <= args.NewIndex)
                {
                    question.Position--;
                }
            }
        }
        else
        {
            // Moving up: shift intervening questions down.
            foreach (var question in DeafultInterviewQuestions.Where(w => w.Section == activeSection))
            {
                if (question.Id != itemToMove.Id &&
                    question.Position >= args.NewIndex &&
                    question.Position < args.OldIndex)
                {
                    question.Position++;
                }
            }
        }

        itemToMove.Position = args.NewIndex;
        DataSource.Upsert(DeafultInterviewQuestions);
    }

    /// <summary>
    /// Save the edited question
    /// </summary>
    /// <param name="question">default questions information</param>
    private void OnBlur_SaveQuestion(InterviewQuestion question)
    {
        if (editingQuestionId != question.Id)
            return;

        question.Question = question.Question?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(question.Question))
        {
            OnClick_DeleteQuestion(question);
        }
        else
        {
            DataSource.Upsert(DeafultInterviewQuestions);
            editingQuestionId = null;            
        }
    }      
}
